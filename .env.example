# SoftGit Environment Configuration
# Copy to .env and adjust for your deployment

# Application
APP_ENV=production
APP_NAME=SoftGit
APP_URL=https://git.example.com
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
HTTP_PORT=3000
LOG_LEVEL=info
LOG_FORMAT=json

# Domain (used by Caddy)
DOMAIN=git.example.com

# Database (PostgreSQL)
DATABASE_URL=postgres://softgit:softgit@postgres:5432/softgit?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# Redis
REDIS_URL=redis://redis:6379/0

# Git storage
GIT_ROOT=/data/git
GIT_HTTP_BACKEND_TIMEOUT=3600

# Object / file storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage
# For S3-compatible:
# STORAGE_BACKEND=s3
# S3_ENDPOINT=
# S3_BUCKET=softgit
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# SSH
SSH_ENABLED=true
SSH_HOST=0.0.0.0
SSH_PORT=2222
SSH_HOST_KEY_PATH=/data/ssh/ssh_host_ed25519_key
# Public host/port advertised to users
SSH_PUBLIC_HOST=git.example.com
SSH_PUBLIC_PORT=22

# Authentication
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
SESSION_TTL_HOURS=168
ACCESS_TOKEN_TTL_HOURS=1
REFRESH_TOKEN_TTL_HOURS=720
PASSWORD_MIN_LENGTH=8
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300

# Email (optional – leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@git.example.com
SMTP_TLS=true

# Webhooks
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=5

# Uploads
MAX_UPLOAD_SIZE_MB=100
MAX_AVATAR_SIZE_MB=5
MAX_RELEASE_ASSET_SIZE_MB=500

# Admin
# First user created becomes admin if no admin exists, or set:
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# Metrics / observability
METRICS_ENABLED=true
TRACING_ENABLED=false
