# Host Caddy — SoftGit public site on port 27296
:27296 {
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /*.git* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /health {
		reverse_proxy 127.0.0.1:3000
	}

	handle /ready {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
